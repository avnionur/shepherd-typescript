{
    "name": "@avnionur/shepherd-typescript",
    "version": "2.35.1",
    "packageManager": "pnpm@10.32.1",
    "description": "A TypeScript implementation of reversible agent execution traces.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/avnionur/shepherd-typescript.git"
    },
    "homepage": "https://github.com/avnionur/shepherd-typescript#readme",
    "bugs": {
        "url": "https://github.com/avnionur/shepherd-typescript/issues"
    },
    "bin": {
        "shepherd-ts": "dist/src/cli/main.js"
    },
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js"
        },
        "./applications": {
            "types": "./dist/src/facades/applications.d.ts",
            "import": "./dist/src/facades/applications.js"
        },
        "./canonical": {
            "types": "./dist/src/facades/canonical.d.ts",
            "import": "./dist/src/facades/canonical.js"
        },
        "./cli": {
            "types": "./dist/src/facades/cli.d.ts",
            "import": "./dist/src/facades/cli.js"
        },
        "./delegation": {
            "types": "./dist/src/facades/delegation.d.ts",
            "import": "./dist/src/facades/delegation.js"
        },
        "./effects": {
            "types": "./dist/src/facades/effects.d.ts",
            "import": "./dist/src/facades/effects.js"
        },
        "./operations": {
            "types": "./dist/src/facades/operations.d.ts",
            "import": "./dist/src/facades/operations.js"
        },
        "./providers": {
            "types": "./dist/src/facades/providers.d.ts",
            "import": "./dist/src/facades/providers.js"
        },
        "./read": {
            "types": "./dist/src/facades/read.d.ts",
            "import": "./dist/src/facades/read.js"
        },
        "./replay": {
            "types": "./dist/src/facades/replay.d.ts",
            "import": "./dist/src/facades/replay.js"
        },
        "./runs": {
            "types": "./dist/src/facades/runs.d.ts",
            "import": "./dist/src/facades/runs.js"
        },
        "./scopes": {
            "types": "./dist/src/facades/scopes.d.ts",
            "import": "./dist/src/facades/scopes.js"
        },
        "./supervision": {
            "types": "./dist/src/facades/supervision.d.ts",
            "import": "./dist/src/facades/supervision.js"
        },
        "./tasks": {
            "types": "./dist/src/facades/tasks.d.ts",
            "import": "./dist/src/facades/tasks.js"
        },
        "./trace": {
            "types": "./dist/src/facades/trace.d.ts",
            "import": "./dist/src/facades/trace.js"
        },
        "./workspace": {
            "types": "./dist/src/facades/workspace.d.ts",
            "import": "./dist/src/facades/workspace.js"
        }
    },
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "type": "module",
    "private": true,
    "exampleManifest": "examples/manifest.json",
    "files": [
        "dist/src",
        "dist/protocol.config.json",
        "dist/public-errors.config.json",
        "dist/runtime.config.json",
        "/api-reference.config.json",
        "docs/generated/api-reference.md",
        "docs/generated/cli-reference.md",
        "docs/typescript-examples.md",
        "docs/python-to-typescript.md",
        "docs/runtime-support.md",
        "/examples",
        "spec/schemas",
        "/README.md",
        "/LICENSE",
        "/NOTICE"
    ],
    "engines": {
        "node": ">=24.12.0 <25"
    },
    "scripts": {
        "build": "node scripts/clean-build.ts && tsc -p tsconfig.build.json && node scripts/copy-runtime-config.ts",
        "bench:carriers": "node scripts/bench-carriers.ts",
        "bench:kernel": "pnpm build && node scripts/bench-kernel.ts",
        "build:desktop": "pnpm build",
        "check:api-reference": "node scripts/generate-api-reference-cli.ts --check",
        "check:compatibility": "node scripts/check-compatibility-cli.ts --check",
        "check:evaluation": "node scripts/evaluate-applications-cli.ts --check",
        "check:protocol": "node scripts/generate-protocol-artifacts-cli.ts --check",
        "check:sbom": "node scripts/generate-sbom-cli.ts --check",
        "check:slo": "pnpm build && node scripts/bench-kernel.ts --check-slo",
        "evaluate:applications": "node scripts/evaluate-applications-cli.ts",
        "format": "biome format --write .",
        "fuzz": "node scripts/fuzz-cli.ts --tier extended",
        "generate:api-reference": "pnpm build && node scripts/generate-api-reference-cli.ts",
        "generate:protocol": "node scripts/generate-protocol-artifacts-cli.ts",
        "generate:sbom": "node scripts/generate-sbom-cli.ts",
        "lint": "biome check .",
        "release:manifest": "node scripts/release-manifest-cli.ts",
        "release:reproducible-build": "node scripts/reproducible-build-cli.ts",
        "sync:version": "node scripts/sync-version-cli.ts",
        "test:carriers:linux": "node scripts/test-carriers-linux.ts",
        "test:faults:volume": "node --test test/faults/volume-enospc.suite.ts",
        "test:package-cli": "node scripts/test-packaged-cli.ts",
        "test:runtime-boundaries": "node scripts/test-packaged-cli.ts --runtime-boundaries",
        "test": "node scripts/run-tests.ts --parallel",
        "test:serial": "node scripts/run-tests.ts --serial",
        "test:soak": "node scripts/soak-cli.ts",
        "typecheck": "tsc --noEmit",
        "update:compatibility-baseline": "pnpm build && node scripts/check-compatibility-cli.ts --update",
        "verify": "pnpm check:protocol && pnpm check:evaluation && pnpm check:sbom && pnpm build && pnpm check:api-reference && pnpm check:compatibility && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:package-cli",
        "verify:release": "pnpm verify && pnpm check:slo && pnpm release:reproducible-build && pnpm release:manifest",
        "verify:serial": "pnpm check:protocol && pnpm check:evaluation && pnpm check:sbom && pnpm build && pnpm check:api-reference && pnpm check:compatibility && pnpm lint && pnpm typecheck && pnpm test:serial && pnpm build && pnpm test:package-cli"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@types/node": "26.6.1",
        "ajv": "8.20.0",
        "rollup": "npm:@rollup/wasm-node@4.63.1",
        "typescript": "7.0.2",
        "yaml": "2.9.1"
    }
}
