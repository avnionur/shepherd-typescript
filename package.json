{
    "name": "@avnionur/shepherd-typescript",
    "version": "1.16.0",
    "packageManager": "pnpm@10.32.1",
    "description": "A TypeScript implementation of reversible agent execution traces.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/avnionur/shepherd-typescript.git"
    },
    "homepage": "https://github.com/avnionur/shepherd-typescript#readme",
    "bugs": {
        "url": "https://github.com/avnionur/shepherd-typescript/issues"
    },
    "type": "module",
    "private": true,
    "files": [
        "dist/src",
        "dist/protocol.config.json",
        "spec/schemas",
        "README.md",
        "LICENSE",
        "NOTICE"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "build": "node scripts/clean-build.ts && tsc -p tsconfig.build.json && node scripts/copy-runtime-config.ts",
        "build:desktop": "pnpm build",
        "check:protocol": "node scripts/generate-protocol-artifacts-cli.ts --check",
        "format": "biome format --write .",
        "generate:protocol": "node scripts/generate-protocol-artifacts-cli.ts",
        "lint": "biome check .",
        "sync:version": "node scripts/sync-version-cli.ts",
        "test": "node --test --experimental-test-coverage --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-lines=100 --test-coverage-include=\"src/**/*.ts\" --test-coverage-include=\"scripts/build-output.ts\" --test-coverage-include=\"scripts/sync-version.ts\" --test-coverage-include=\"scripts/generate-protocol-artifacts.ts\" \"test/**/*.test.ts\"",
        "typecheck": "tsc --noEmit",
        "verify": "pnpm check:protocol && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.6",
        "@types/node": "26.1.2",
        "ajv": "8.20.0",
        "typescript": "7.0.2",
        "yaml": "2.9.0"
    }
}
