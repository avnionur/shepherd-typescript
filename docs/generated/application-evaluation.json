    "compatibility_version": "shepherd.applications.v1",
    "evaluation_id": "phase-10-offline-applications",
    "limitations": [
        {
            "id": "offline-static-providers",
            "text": "Every provider is an offline static fixture: exact order-bound cassettes for the Tree-RL source and rollouts, and request-keyed providers with a static descriptor where an application serves repeated sessions or workers from one provider. Token counts and costs are the fixtures' configured per-call usage, not provider billing."
        },
        {
            "id": "no-live-provider",
            "text": "No live model provider is called. Nothing here measures model quality, latency, or behavior under real provider variance."
        },
        {
            "id": "synthetic-fixtures",
            "text": "Fixtures are synthetic and small: one dataset item per application, four or five workflow stages, two supervised workers, two optimizer candidates, and the configured seeds. The figures describe these fixtures, not a benchmark or task distribution."
        },
        {
            "id": "no-wall-clock",
            "text": "No wall-clock time, throughput, or duration is measured or reported. Steps and provider calls are counts, not time."
        },
        {
            "id": "repository-baselines",
            "text": "Baselines are this repository's constructions: no_supervision runs one worker once as a plain child run without a policy, full_replay re-runs the whole workflow per candidate, no_compression keeps the recorded source trajectory, and single_rollout reuses branch 0 of each fork point. None is an upstream baseline."
        },
        {
            "id": "single-rollout-shared-cost",
            "text": "The Tree-RL single_rollout baseline reuses the tree's branch-0 rollouts instead of running separate sessions, so its cost is a subset of the tree batch's cost, not an equal budget; a failed branch-0 rollout still counts in the baseline's cost and steps and makes baseline success false (the v4 single_rollout training batch drops that fork point)."
        },
        {
            "id": "measurement-scope",
            "text": "Application-side metrics count only the work compared against the baseline: supervised worker starts and retained completions, counterfactual candidate branch sessions, the compression result session, and every Tree-RL rollout. Supervisor rounds, recorded baseline and source sessions, compressor and verifier children, and best-of-N controls appear only in each run's manifest costs."
        },
        {
            "id": "single-host",
            "text": "Each generation runs on one host. The report bytes are host-independent by construction, but no multi-host, concurrent-writer, or crash-injected evaluation is performed."
        },
        {
            "id": "no-upstream-reproduction",
            "text": "Upstream headline results (paired coding success, optimizer dev-set gains, compression ratios, and Tree-RL training gains) are not reproduced. No figure in this report is comparable to a published number."
        },
        {
            "id": "no-training",
            "text": "The Tree-RL adapter emits a training batch and trains nothing; no learning result is claimed."
        }
    ],
