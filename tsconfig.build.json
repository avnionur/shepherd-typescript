{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "allowImportingTsExtensions": false,
        "declaration": true,
        "declarationMap": true,
        "noEmit": false,
        "outDir": "dist",
        "rootDir": ".",
        "rewriteRelativeImportExtensions": true,
        "sourceMap": true
    },
    "include": ["src/**/*.ts"]
}
