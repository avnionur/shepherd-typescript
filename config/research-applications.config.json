        "kind": "counterfactual_optimization",
        "protocolVersion": "appendix-f.v1",
        "seeds": [7, 19],
        "surfaces": [
            {
                "content": "You optimize a recorded workflow. Inspect the pool of retained candidates and their branch traces, pick a parent candidate (or the baseline), and propose candidate edits. Each edit names the edited step and changes only declarable dimensions: task, provider, or handlers. For every edit, state the fix set (failures it should repair) and the guard set (behaviors it must preserve). Only the affected suffix of the parent's trace is replayed; do not propose rewrites of the recorded prefix.",
                "id": "proposer.propose",
                "kind": "prompt",
                "role": "proposer"
            },
            {
                "content": {
                    "description": "Read the retained candidate pool: every candidate record with its status, parent, edited step, affected steps, divergence summary, verdict, and measured cost.",
                    "inputSchema": {
                        "additionalProperties": false,
                        "properties": {
                            "application_id": {
                                "type": "string"
                            }
                        },
                        "required": ["application_id"],
                        "type": "object"
                    },
                    "name": "inspect_candidates"
                },
                "id": "tool.inspect_candidates",
                "kind": "tool",
                "role": "proposer"
            },
            {
                "content": {
                    "description": "Propose one candidate edit of the parent's workflow at a step boundary.",
                    "inputSchema": {
                        "additionalProperties": false,
                        "properties": {
                            "changes": {
                                "items": {
                                    "enum": ["task", "provider", "handlers"]
                                },
                                "minItems": 1,
                                "type": "array",
                                "uniqueItems": true
                            },
                            "name": {
                                "type": "string"
                            },
                            "parent": {
                                "type": ["string", "null"]
                            },
                            "step_index": {
                                "minimum": 0,
                                "type": "integer"
                            }
                        },
                        "required": ["changes", "name", "parent", "step_index"],
                        "type": "object"
                    },
                    "name": "propose_candidate"
                },
                "id": "tool.propose_candidate",
                "kind": "tool",
                "role": "proposer"
            },
            {
                "content": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "additionalProperties": false,
                    "properties": {
                        "fix_set": {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "guard_set": {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "observations": {
                            "items": {
                                "type": "string"
                            },
                            "type": "array"
                        },
                        "parent": {
                            "type": ["string", "null"]
                        }
                    },
                    "required": ["fix_set", "guard_set", "observations", "parent"],
                    "type": "object"
                },
                "id": "scratchpad.reflection.v1",
                "kind": "schema",
                "role": "reflection"
            },
            {
                "content": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "additionalProperties": false,
                    "properties": {
                        "candidates": {
                            "items": {
                                "additionalProperties": false,
                                "properties": {
                                    "candidate_id": {
                                        "type": "string"
                                    },
                                    "parent_candidate_id": {
                                        "type": ["string", "null"]
                                    },
                                    "status": {
                                        "enum": ["proposed", "evaluated", "promoted", "rejected"]
                                    }
                                },
                                "required": ["candidate_id", "parent_candidate_id", "status"],
                                "type": "object"
                            },
                            "type": "array"
                        },
                        "promoted_candidate_id": {
                            "type": ["string", "null"]
                        }
                    },
                    "required": ["candidates", "promoted_candidate_id"],
                    "type": "object"
                },
                "id": "handoff.manifest.v1",
                "kind": "schema",
                "role": "handoff"
            }
        ]
    },
