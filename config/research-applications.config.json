        "kind": "trajectory_compression",
        "protocolVersion": "appendix-d.v1",
        "seeds": [7, 19, 23],
        "surfaces": [
            {
                "content": "You compress a recorded agent trajectory in hindsight. Inspect the source steps, their requests and outputs, and the retained checkpoints. Propose at most one fork point: the step boundary after which the remaining steps could be replaced by a shorter rerun that reaches the same verified result, and a hint telling the rerun how to get there, citing the source steps it relies on. Return the proposal as JSON matching the compression schema; return a null fork point when no shorter rerun is plausible. Never propose a fork point inside a prefix you cannot restore.",
                "id": "compressor.propose",
                "kind": "prompt",
                "role": "compressor"
            },
            {
                "content": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "additionalProperties": false,
                    "properties": {
                        "fork_point": {
                            "oneOf": [
                                {
                                    "type": "null"
                                },
                                {
                                    "additionalProperties": false,
                                    "properties": {
                                        "prefix_id": {
                                            "type": "string"
                                        },
                                        "session_id": {
                                            "type": "string"
                                        },
                                        "step_index": {
                                            "minimum": 1,
                                            "type": "integer"
                                        }
                                    },
                                    "required": ["prefix_id", "session_id", "step_index"],
                                    "type": "object"
                                }
                            ]
                        },
                        "hint": {
                            "oneOf": [
                                {
                                    "type": "null"
                                },
                                {
                                    "additionalProperties": false,
                                    "properties": {
                                        "cited_step_indices": {
                                            "items": {
                                                "minimum": 0,
                                                "type": "integer"
                                            },
                                            "type": "array",
                                            "uniqueItems": true
                                        },
                                        "text": {
                                            "minLength": 1,
                                            "type": "string"
                                        }
                                    },
                                    "required": ["cited_step_indices", "text"],
                                    "type": "object"
                                }
                            ]
                        }
                    },
                    "required": ["fork_point", "hint"],
                    "type": "object"
                },
                "id": "compression.fork-hint.v1",
                "kind": "schema",
                "role": "compression"
            },
            {
                "content": "You verify a compressed trajectory against the original. Compare the terminal results and the evidence each trajectory retained. Accept only when the compressed trajectory reaches the same result the original verified; otherwise reject and say why. Return JSON with verdict (accepted or rejected), a numeric score, and a reason.",
                "id": "verifier.judge",
                "kind": "prompt",
                "role": "verifier"
            }
        ]
    },
    "counterfactual": {
        "budgets": {
            "maxCandidates": 4,
            "maxProviderCalls": 40,
            "minPromotionScore": 1
