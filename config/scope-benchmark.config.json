                "description": "Linux on arm64 with the benchmark temporary directory on XFS (filesystem type 0x58465342), as in the privileged container lane of pnpm bench:scopes:linux: loopback XFS with reflink=1 on tmpfs, run as root, where copy, clone, and overlay carriers are conformant. Measured in a Linux container in OrbStack's virtual machine on the macOS arm64 reference host; the budgets are only evidence for that measurement host",
                "id": "linux-arm64-xfs-privileged-container",
                "match": {
                    "arch": "arm64",
                    "filesystemTypes": [1481003842],
                    "platform": "linux"
                }
            }
        ]
    },
    "linux": {
        "containerOutput": "/output",
        "containerSource": "/source",
        "containerWorkspace": "/workspace",
        "dockerExecutable": "docker",
        "dockerRunArguments": ["run", "--rm", "--privileged"],
        "hostOutput": "docs/generated/benchmarks",
        "image": "node:24-bookworm",
        "shellArguments": ["-euo", "pipefail", "-c"],
        "shellExecutable": "bash",
        "steps": [
            "node --version",
            "apt-get update -qq",
            "DEBIAN_FRONTEND=noninteractive apt-get install -y -qq acl attr xfsprogs > /dev/null",
            "mkdir -p {workspace}/repo {workspace}/reflink",
            "tar -C {source} --exclude=./node_modules --exclude=./dist --exclude=./.git -cf - . | tar -C {workspace}/repo -xf -",
            "cd {workspace}/repo",
            "corepack enable",
            "COREPACK_ENABLE_DOWNLOAD_PROMPT=0 pnpm install --frozen-lockfile",
            "truncate -s 3g {workspace}/reflink.img",
            "mkfs.xfs -q -m reflink=1 {workspace}/reflink.img",
            "mount -o loop {workspace}/reflink.img {workspace}/reflink",
            "chmod 1777 {workspace}/reflink",
            "echo 'scope benchmark on loopback XFS reflink=1 (copy, clone, and overlay conformant)'",
            "TMPDIR={workspace}/reflink pnpm bench:scopes",
            "cp {workspace}/repo/{resultDirectory}/{resultPrefix}*.json {output}/",
            "umount {workspace}/reflink"
        ],
        "tmpfsOptions": "rw,exec,mode=1777,size=6g",
        "tokens": {
            "output": "{output}",
            "resultDirectory": "{resultDirectory}",
            "resultPrefix": "{resultPrefix}",
            "source": "{source}",
            "workspace": "{workspace}"
        }
    }
}
