{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/delegation-decision-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Delegation Decision v1",
    "description": "Terminal accept or discard decision for one child run handle, citing the accepted output.",
    "type": "object",
    "required": [
        "compatibility_version",
        "delegation_version",
        "child_outcome_record_id",
        "command_id",
        "handle_id",
        "kind",
        "output_id",
        "reason",
        "supervisor_id"
    ],
    "properties": {
        "compatibility_version": {
            "const": "shepherd.delegation.v1"
        },
        "delegation_version": {
            "const": 1
        },
        "child_outcome_record_id": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/$defs/recordId"
                }
            ]
        },
        "command_id": {
            "type": "string",
            "minLength": 1
        },
        "handle_id": {
            "$ref": "#/$defs/handleId"
        },
        "kind": {
            "enum": [
                "accepted",
                "discarded"
            ]
        },
        "output_id": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/$defs/recordId"
                }
            ]
        },
        "reason": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                }
            ]
        },
        "supervisor_id": {
            "$ref": "#/$defs/supervisorId"
        }
    },
    "additionalProperties": false,
    "$defs": {
        "budget": {
            "type": "object",
            "properties": {
                "maxCostUsd": {
                    "type": "number",
                    "minimum": 0
                },
                "maxDurationMilliseconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "maxEffects": {
                    "type": "integer",
                    "minimum": 0
                },
                "maxInputTokens": {
                    "type": "integer",
                    "minimum": 0
                },
                "maxOutputTokens": {
                    "type": "integer",
                    "minimum": 0
                },
                "maxTurns": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "grants": {
            "type": "array",
            "maxItems": 64,
            "items": {
                "type": "object",
                "required": [
                    "atoms",
                    "resource_id",
                    "resource_kind"
                ],
                "properties": {
                    "atoms": {
                        "type": "array",
                        "items": {
                            "enum": [
                                "read",
                                "write"
                            ]
                        },
                        "uniqueItems": true
                    },
                    "resource_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "resource_kind": {
                        "enum": [
                            "repository_binding",
                            "workspace_binding"
                        ]
                    }
                },
                "additionalProperties": false
            }
        },
        "handleId": {
            "type": "string",
            "pattern": "^delegation:sha256:[0-9a-f]{64}$"
        },
        "recordId": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "semanticValue": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                },
                {
                    "type": "number"
                },
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/semanticValue"
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/semanticValue"
                    }
                }
            ]
        },
        "supervisorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
        },
        "taskArtifactLock": {
            "type": "object",
            "required": [
                "artifact_digest",
                "artifact_lock_version",
                "compatibility_version",
                "descriptor_version",
                "schema_digest",
                "task_id",
                "task_version"
            ],
            "properties": {
                "artifact_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "artifact_lock_version": {
                    "const": 1
                },
                "compatibility_version": {
                    "const": "shepherd.tasks.v1"
                },
                "descriptor_version": {
                    "const": 1
                },
                "schema_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "task_id": {
                    "type": "string",
                    "pattern": "^task:sha256:[0-9a-f]{64}$"
                },
                "task_version": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "taskDescriptor": {
            "type": "object",
            "required": [
                "compatibility_version",
                "descriptor_version",
                "input_schema",
                "instruction",
                "name",
                "output_schema",
                "task_version"
            ],
            "properties": {
                "compatibility_version": {
                    "const": "shepherd.tasks.v1"
                },
                "descriptor_version": {
                    "const": 1
                },
                "input_schema": {
                    "$ref": "#/$defs/taskSchema"
                },
                "instruction": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "output_schema": {
                    "$ref": "#/$defs/taskSchema"
                },
                "task_version": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "taskSchema": {
            "oneOf": [
                {
                    "type": "object",
                    "required": [
                        "type"
                    ],
                    "properties": {
                        "type": {
                            "const": "string"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "type"
                    ],
                    "properties": {
                        "type": {
                            "const": "null"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "additionalProperties",
                        "properties",
                        "required",
                        "type"
                    ],
                    "properties": {
                        "additionalProperties": {
                            "const": false
                        },
                        "properties": {
                            "type": "object",
                            "additionalProperties": {
                                "$ref": "#/$defs/taskSchema"
                            }
                        },
                        "required": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            },
                            "uniqueItems": true
                        },
                        "type": {
                            "const": "object"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "$ref"
                    ],
                    "properties": {
                        "$ref": {
                            "const": "https://avnionur.github.io/shepherd-typescript/schemas/task-value-v1.schema.json"
                        }
                    },
                    "additionalProperties": false
                }
            ]
        },
        "taskValue": {
            "type": "object",
            "required": [
                "artifact",
                "artifact_lock"
            ],
            "properties": {
                "artifact": {
                    "$ref": "#/$defs/taskDescriptor"
                },
                "artifact_lock": {
                    "$ref": "#/$defs/taskArtifactLock"
                }
            },
            "additionalProperties": false
        }
    }
}
