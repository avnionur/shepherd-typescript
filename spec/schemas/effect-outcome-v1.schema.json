{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/effect-outcome-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Effect Outcome v1",
    "description": "Typed world response bound to one complete canonical effect intent.",
    "type": "object",
    "required": [
        "effect_id",
        "intent_ref",
        "kind",
        "outcome_version",
        "phase",
        "result"
    ],
    "properties": {
        "effect_id": {
            "type": "string",
            "minLength": 1
        },
        "intent_ref": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "kind": {
            "type": "string",
            "minLength": 1
        },
        "outcome_version": {
            "const": 1
        },
        "phase": {
            "const": "outcome"
        },
        "result": {
            "oneOf": [
                {
                    "type": "object",
                    "required": [
                        "ok",
                        "value"
                    ],
                    "properties": {
                        "ok": {
                            "const": true
                        },
                        "value": {
                            "$ref": "#/$defs/semanticValue"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "error",
                        "ok"
                    ],
                    "properties": {
                        "error": {
                            "$ref": "#/$defs/semanticValue"
                        },
                        "ok": {
                            "const": false
                        }
                    },
                    "additionalProperties": false
                }
            ]
        }
    },
    "additionalProperties": false,
    "$defs": {
        "semanticValue": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                },
                {
                    "type": "number"
                },
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/semanticValue"
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/semanticValue"
                    }
                }
            ]
        }
    }
}
