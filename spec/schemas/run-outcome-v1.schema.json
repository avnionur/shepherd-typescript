{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/run-outcome-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Run Outcome v1",
    "description": "Exactly one inspectable terminal result for a task run.",
    "type": "object",
    "required": [
        "outcome_version",
        "run_id",
        "task_artifact_lock",
        "outcome"
    ],
    "properties": {
        "outcome_version": {
            "const": 1
        },
        "run_id": {
            "type": "string",
            "minLength": 1
        },
        "task_artifact_lock": {
            "$ref": "#/$defs/taskArtifactLock"
        },
        "outcome": {
            "oneOf": [
                {
                    "type": "object",
                    "required": [
                        "status",
                        "value"
                    ],
                    "properties": {
                        "status": {
                            "const": "finished"
                        },
                        "value": {
                            "$ref": "#/$defs/semanticValue"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "error_type",
                        "message",
                        "retryable",
                        "status"
                    ],
                    "properties": {
                        "error_type": {
                            "type": "string",
                            "minLength": 1
                        },
                        "message": {
                            "type": "string",
                            "minLength": 1
                        },
                        "retryable": {
                            "type": [
                                "boolean",
                                "null"
                            ]
                        },
                        "status": {
                            "const": "failed"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "reason",
                        "status"
                    ],
                    "properties": {
                        "reason": {
                            "type": "string",
                            "minLength": 1
                        },
                        "status": {
                            "const": "exhausted"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "reason",
                        "status"
                    ],
                    "properties": {
                        "reason": {
                            "type": "string",
                            "minLength": 1
                        },
                        "status": {
                            "const": "cancelled"
                        }
                    },
                    "additionalProperties": false
                }
            ]
        }
    },
    "additionalProperties": false,
    "$defs": {
        "semanticValue": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                },
                {
                    "type": "number"
                },
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/semanticValue"
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/semanticValue"
                    }
                }
            ]
        },
        "taskArtifactLock": {
            "type": "object",
            "required": [
                "artifact_digest",
                "artifact_lock_version",
                "compatibility_version",
                "descriptor_version",
                "schema_digest",
                "task_id",
                "task_version"
            ],
            "properties": {
                "artifact_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "artifact_lock_version": {
                    "const": 1
                },
                "compatibility_version": {
                    "const": "shepherd.tasks.v1"
                },
                "descriptor_version": {
                    "const": 1
                },
                "schema_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "task_id": {
                    "type": "string",
                    "pattern": "^task:sha256:[0-9a-f]{64}$"
                },
                "task_version": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        }
    }
}
