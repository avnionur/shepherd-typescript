{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/supervision-approval-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Supervision Approval v1",
    "description": "Approval request for one exact effective intent, or the verdict that resolves it.",
    "oneOf": [
        {
            "type": "object",
            "required": [
                "compatibility_version",
                "supervision_version",
                "dispatch_id",
                "gate",
                "intent_ref",
                "phase",
                "position",
                "reason"
            ],
            "properties": {
                "compatibility_version": {
                    "const": "shepherd.supervision.v1"
                },
                "supervision_version": {
                    "const": 1
                },
                "dispatch_id": {
                    "$ref": "#/$defs/dispatchId"
                },
                "gate": {
                    "enum": [
                        "interceptor_pause",
                        "irreversible_frontier"
                    ]
                },
                "intent_ref": {
                    "$ref": "#/$defs/intentRef"
                },
                "phase": {
                    "const": "requested"
                },
                "position": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "integer",
                            "minimum": 0
                        }
                    ]
                },
                "reason": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "string",
                            "minLength": 1,
                            "x-shepherd-max-utf8-bytes": 4096
                        }
                    ]
                }
            },
            "additionalProperties": false
        },
        {
            "type": "object",
            "required": [
                "compatibility_version",
                "supervision_version",
                "approver_id",
                "command_id",
                "dispatch_id",
                "phase",
                "reason",
                "request_record_id",
                "verdict"
            ],
            "properties": {
                "compatibility_version": {
                    "const": "shepherd.supervision.v1"
                },
                "supervision_version": {
                    "const": 1
                },
                "approver_id": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "string",
                            "minLength": 1
                        }
                    ]
                },
                "command_id": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "string",
                            "minLength": 1
                        }
                    ]
                },
                "dispatch_id": {
                    "$ref": "#/$defs/dispatchId"
                },
                "phase": {
                    "const": "resolved"
                },
                "reason": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "string",
                            "minLength": 1,
                            "x-shepherd-max-utf8-bytes": 4096
                        }
                    ]
                },
                "request_record_id": {
                    "$ref": "#/$defs/recordId"
                },
                "verdict": {
                    "enum": [
                        "approved",
                        "rejected",
                        "expired"
                    ]
                }
            },
            "additionalProperties": false
        }
    ],
    "$defs": {
        "dispatchId": {
            "type": "string",
            "pattern": "^supervision-dispatch:sha256:[0-9a-f]{64}$"
        },
        "effectIntent": {
            "type": "object",
            "required": [
                "effect_id",
                "intent_version",
                "kind",
                "payload",
                "phase",
                "reversibility"
            ],
            "properties": {
                "effect_id": {
                    "type": "string",
                    "minLength": 1
                },
                "intent_version": {
                    "const": 1
                },
                "kind": {
                    "type": "string",
                    "minLength": 1
                },
                "payload": {
                    "$ref": "#/$defs/semanticValue"
                },
                "phase": {
                    "const": "intent"
                },
                "reversibility": {
                    "enum": [
                        "reversible",
                        "compensable",
                        "irreversible"
                    ]
                }
            },
            "additionalProperties": false
        },
        "effectOutcome": {
            "type": "object",
            "required": [
                "effect_id",
                "intent_ref",
                "kind",
                "outcome_version",
                "phase",
                "result"
            ],
            "properties": {
                "effect_id": {
                    "type": "string",
                    "minLength": 1
                },
                "intent_ref": {
                    "$ref": "#/$defs/intentRef"
                },
                "kind": {
                    "type": "string",
                    "minLength": 1
                },
                "outcome_version": {
                    "const": 1
                },
                "phase": {
                    "const": "outcome"
                },
                "result": {
                    "oneOf": [
                        {
                            "type": "object",
                            "required": [
                                "ok",
                                "value"
                            ],
                            "properties": {
                                "ok": {
                                    "const": true
                                },
                                "value": {
                                    "$ref": "#/$defs/semanticValue"
                                }
                            },
                            "additionalProperties": false
                        },
                        {
                            "type": "object",
                            "required": [
                                "error",
                                "ok"
                            ],
                            "properties": {
                                "error": {
                                    "$ref": "#/$defs/semanticValue"
                                },
                                "ok": {
                                    "const": false
                                }
                            },
                            "additionalProperties": false
                        }
                    ]
                }
            },
            "additionalProperties": false
        },
        "intentRef": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "recordId": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "semanticValue": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                },
                {
                    "type": "number"
                },
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/semanticValue"
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/semanticValue"
                    }
                }
            ]
        }
    }
}
