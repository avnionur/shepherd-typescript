{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/application-cro-candidate-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Application Counterfactual Candidate v1",
    "description": "Counterfactual Replay Optimization records on the application owner path: the opened record naming every per-example baseline session and score, one proposal record per proposer iteration, one outcome record per candidate retaining its fix, guard, dev, and train example branches with divergence proofs, scores, parent scores, gate verdict, promotion reference, failure, and measured cost, and the terminal selection.",
