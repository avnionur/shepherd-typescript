{
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/retained-world-application-conflict-v1.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
        "compatibility_version": {
            "const": "shepherd.workspace.retained-world-application.v1",
            "type": "string"
        },
        "conflict_id": {
            "pattern": "^world-application-conflict:sha256:[0-9a-f]{64}$",
            "type": "string"
        },
        "conflict_version": {
            "const": 1,
            "type": "integer"
        },
        "conflicts": {
            "items": {
                "additionalProperties": false,
                "properties": {
                    "candidate_path": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "current_path": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "kind": {
                        "enum": [
                            "equal-path",
                            "ancestor-descendant",
                            "portable-alias"
                        ],
                        "type": "string"
                    }
                },
                "required": [
                    "candidate_path",
                    "current_path",
                    "kind"
                ],
                "type": "object"
            },
            "maxItems": 1000,
            "minItems": 1,
            "type": "array"
        }
    },
    "required": [
        "compatibility_version",
        "conflict_id",
        "conflict_version",
        "conflicts"
    ],
    "type": "object"
}
