{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/application-manifest-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Application Manifest v1",
    "description": "Canonical digest-bearing manifest of one application run: protocol identity over prompt, schema, and tool surfaces, budgets, optional thresholds, seeds, dataset selection, produced artifacts cited by identity, measured costs, and optional per-session computation reuse.",
    "type": "object",
    "required": [
        "application_id",
        "artifacts",
        "budgets",
        "compatibility_version",
        "costs",
        "dataset",
        "kind",
        "manifest_id",
        "manifest_version",
        "protocol_id",
        "protocol_version",
        "seeds",
        "surfaces"
    ],
    "properties": {
        "application_id": {
            "$ref": "#/$defs/applicationId"
        },
        "artifacts": {
            "type": "array",
            "maxItems": 128,
            "items": {
                "type": "object",
                "required": [
                    "artifact_id",
                    "cut_id",
                    "digest",
                    "record_id",
                    "role"
                ],
                "properties": {
                    "artifact_id": {
                        "type": "string",
                        "pattern": "^application-artifact:sha256:[0-9a-f]{64}$"
                    },
                    "cut_id": {
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "type": "string",
                                "minLength": 1
                            }
                        ]
                    },
                    "digest": {
                        "$ref": "#/$defs/digest"
                    },
                    "record_id": {
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "$ref": "#/$defs/recordId"
                            }
                        ]
                    },
                    "role": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "additionalProperties": false
            }
        },
        "budgets": {
            "type": "object",
            "additionalProperties": {
                "type": "integer",
                "minimum": 0
            }
        },
        "compatibility_version": {
            "const": "shepherd.applications.v1"
        },
        "computation_reuse": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "live_steps",
                    "recorded_steps",
                    "reuse_ratio",
                    "session_index"
                ],
                "properties": {
                    "live_steps": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "recorded_steps": {
                        "type": "integer",
                        "minimum": 0
                    },
                    "reuse_ratio": {
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                            }
                        ]
                    },
                    "session_index": {
                        "type": "integer",
                        "minimum": 0
                    }
                },
                "additionalProperties": false
            }
        },
        "costs": {
            "type": "object",
            "required": [
                "cache_creation_input_tokens",
                "cache_read_input_tokens",
                "cost_usd",
                "input_tokens",
                "output_tokens",
                "provider_calls"
            ],
            "properties": {
                "cache_creation_input_tokens": {
                    "type": "integer",
                    "minimum": 0
                },
                "cache_read_input_tokens": {
                    "type": "integer",
                    "minimum": 0
                },
                "cost_usd": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "number",
                            "minimum": 0
                        }
                    ]
                },
                "input_tokens": {
                    "type": "integer",
                    "minimum": 0
                },
                "output_tokens": {
                    "type": "integer",
                    "minimum": 0
                },
                "provider_calls": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "dataset": {
            "type": "object",
            "required": [
                "id",
                "items",
                "revision"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "items": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "maxItems": 64,
                    "uniqueItems": true
                },
                "revision": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "kind": {
            "enum": [
                "coding_supervisor",
                "counterfactual_optimization",
                "trajectory_compression",
                "tree_rl"
            ]
        },
        "manifest_id": {
            "type": "string",
            "pattern": "^application-manifest:sha256:[0-9a-f]{64}$"
        },
        "manifest_version": {
            "const": 1
        },
        "protocol_id": {
            "type": "string",
            "pattern": "^application-protocol:sha256:[0-9a-f]{64}$"
        },
        "protocol_version": {
            "type": "string",
            "minLength": 1
        },
        "seeds": {
            "type": "array",
            "items": {
                "type": "integer"
            },
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true
        },
        "surfaces": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
                "type": "object",
                "required": [
                    "digest",
                    "id",
                    "kind",
                    "role"
                ],
                "properties": {
                    "digest": {
                        "$ref": "#/$defs/digest"
                    },
                    "id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "kind": {
                        "enum": [
                            "prompt",
                            "schema",
                            "tool"
                        ]
                    },
                    "role": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "additionalProperties": false
            }
        },
        "thresholds": {
            "type": "object",
            "additionalProperties": {
                "type": "number"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "applicationId": {
            "type": "string",
            "pattern": "^application:sha256:[0-9a-f]{64}$"
        },
        "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "handleId": {
            "type": "string",
            "pattern": "^delegation:sha256:[0-9a-f]{64}$"
        },
        "paths": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "maxItems": 100000,
            "uniqueItems": true
        },
        "recordId": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "semanticValue": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                },
                {
                    "type": "number"
                },
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/semanticValue"
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/semanticValue"
                    }
                }
            ]
        },
        "supervisorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
        }
    }
}
