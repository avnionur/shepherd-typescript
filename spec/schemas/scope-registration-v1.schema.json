{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/scope-registration-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Scope Registration v1",
    "description": "First retained record on one scope owner path binding ownership, origin, authority, and world capability.",
    "type": "object",
    "required": [
        "authority",
        "command_id",
        "compatibility_version",
        "execution_id",
        "kind",
        "parent",
        "scope_id",
        "scope_version",
        "world_capability"
    ],
    "properties": {
        "authority": {
            "type": "object",
            "required": [
                "ceiling",
                "effective"
            ],
            "properties": {
                "ceiling": {
                    "$ref": "#/$defs/resources"
                },
                "effective": {
                    "$ref": "#/$defs/resources"
                }
            },
            "additionalProperties": false
        },
        "command_id": {
            "type": "string",
            "minLength": 1
        },
        "compatibility_version": {
            "const": "shepherd.scope.v1"
        },
        "execution_id": {
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "type": "null"
                }
            ]
        },
        "kind": {
            "enum": [
                "root",
                "child"
            ]
        },
        "parent": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "type": "object",
                    "required": [
                        "child_registered_record_id",
                        "origin_cut_id",
                        "origin_record_id",
                        "scope_id"
                    ],
                    "properties": {
                        "child_registered_record_id": {
                            "$ref": "#/$defs/recordId"
                        },
                        "origin_cut_id": {
                            "$ref": "#/$defs/originCutId"
                        },
                        "origin_record_id": {
                            "$ref": "#/$defs/recordId"
                        },
                        "scope_id": {
                            "$ref": "#/$defs/scopeId"
                        }
                    },
                    "additionalProperties": false
                }
            ]
        },
        "scope_id": {
            "$ref": "#/$defs/scopeId"
        },
        "scope_version": {
            "const": 1
        },
        "world_capability": {
            "enum": [
                "trace_only",
                "reference_copy"
            ]
        }
    },
    "additionalProperties": false,
    "$defs": {
        "originCutId": {
            "type": "string",
            "pattern": "^scope-origin:[0-9a-f]{64}$"
        },
        "recordId": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "resources": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "atoms",
                    "resource_id",
                    "resource_kind"
                ],
                "properties": {
                    "atoms": {
                        "type": "array",
                        "items": {
                            "enum": [
                                "read",
                                "write"
                            ]
                        },
                        "maxItems": 2,
                        "uniqueItems": true
                    },
                    "resource_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "resource_kind": {
                        "enum": [
                            "repository_binding",
                            "workspace_binding"
                        ]
                    }
                },
                "additionalProperties": false
            },
            "maxItems": 64
        },
        "scopeId": {
            "type": "string",
            "pattern": "^scope:sha256:[0-9a-f]{64}$"
        },
        "semanticValue": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                },
                {
                    "type": "number"
                },
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/semanticValue"
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/semanticValue"
                    }
                }
            ]
        }
    }
}
