{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/delegation-opened-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Delegation Opened v1",
    "description": "First record of one child run handle: supervisor, parent, task value, provenance, validated input, requested grant and budget, derived authority, nesting depth, and the discarded predecessor of a retry.",
    "type": "object",
    "required": [
        "compatibility_version",
        "delegation_version",
        "authority",
        "budget",
        "budget_ceiling",
        "child_run_id",
        "command_id",
