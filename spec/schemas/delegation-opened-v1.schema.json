        },
        "child_run_id": {
            "type": "string",
            "pattern": "^delegation-run:sha256:[0-9a-f]{64}$"
        },
        "command_id": {
            "type": "string",
            "minLength": 1
        },
        "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
        },
        "grant": {
            "$ref": "#/$defs/grants"
        },
        "handle_id": {
            "$ref": "#/$defs/handleId"
        },
        "input": {
            "$ref": "#/$defs/semanticValue"
        },
        "parent": {
            "oneOf": [
                {
                    "type": "object",
                    "required": [
                        "kind"
                    ],
                    "properties": {
                        "kind": {
                            "const": "root"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "handle_id",
                        "kind",
