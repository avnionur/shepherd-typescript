                                "boolean",
                                "integer",
                                "number"
                            ]
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "items",
                        "type"
                    ],
                    "properties": {
                        "items": {
                            "$ref": "#/$defs/taskSchema"
                        },
                        "type": {
                            "const": "array"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
