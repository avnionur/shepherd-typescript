                "instruction": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "output_schema": {
                    "$ref": "#/$defs/taskSchema"
                },
                "task_version": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
