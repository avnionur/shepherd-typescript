{
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/retained-world-application-receipt-v1.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
        "action": {
            "const": "apply",
            "type": "string"
        },
        "applied_revision_id": {
            "minLength": 1,
            "type": "string"
        },
        "application_plan_id": {
            "pattern": "^world-application-plan:sha256:[0-9a-f]{64}$",
            "type": "string"
        },
        "operation_id": {
            "minLength": 1,
            "type": "string"
        },
        "publication_id": {
            "minLength": 1,
            "type": "string"
        },
        "receipt_version": {
            "const": 1,
            "type": "integer"
        },
        "request_id": {
            "minLength": 1,
            "type": "string"
        },
        "state": {
            "const": "applied",
            "type": "string"
        },
        "user_basis_after": {
            "minLength": 1,
            "type": "string"
        }
    },
    "required": [
        "action",
        "applied_revision_id",
        "application_plan_id",
        "operation_id",
        "publication_id",
        "receipt_version",
        "request_id",
        "state",
        "user_basis_after"
    ],
    "type": "object"
}
