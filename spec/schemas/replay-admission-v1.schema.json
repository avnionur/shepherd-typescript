{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/replay-admission-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Replay Admission v1",
    "description": "Retained immediately before a live effect handler is invoked.",
    "type": "object",
    "required": [
        "compatibility_version",
        "replay_version",
        "index",
        "intent_ref",
        "session_id"
    ],
    "properties": {
        "compatibility_version": {
            "const": "shepherd.replay.v1"
        },
        "replay_version": {
            "const": 1
        },
        "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
        },
        "intent_ref": {
            "$ref": "#/$defs/intentRef"
        },
        "session_id": {
            "$ref": "#/$defs/sessionId"
        }
    },
    "additionalProperties": false,
    "$defs": {
        "constituents": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "evidence",
                    "kind",
                    "name",
                    "reason",
                    "receipt_id",
                    "status"
                ],
                "properties": {
                    "evidence": {
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "type": "object",
                                "additionalProperties": {
                                    "$ref": "#/$defs/semanticValue"
                                }
                            }
                        ]
                    },
                    "kind": {
                        "enum": [
                            "trace_cut",
                            "world",
                            "provider_session",
                            "process",
                            "irreversible_effects"
                        ]
                    },
                    "name": {
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "type": "string",
                                "minLength": 1
                            }
                        ]
                    },
                    "reason": {
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "type": "string",
                                "minLength": 1,
                                "x-shepherd-max-utf8-bytes": 4096
                            }
                        ]
                    },
                    "receipt_id": {
                        "oneOf": [
                            {
                                "type": "null"
                            },
                            {
                                "type": "string",
                                "minLength": 1
                            }
                        ]
                    },
                    "status": {
                        "enum": [
                            "verified",
                            "reconstructive",
                            "not_applicable",
                            "unavailable"
                        ]
                    }
                },
                "additionalProperties": false
            }
        },
        "effectIntent": {
            "type": "object",
            "required": [
                "effect_id",
                "intent_version",
                "kind",
                "payload",
                "phase",
                "reversibility"
            ],
            "properties": {
                "effect_id": {
                    "type": "string",
                    "minLength": 1
                },
                "intent_version": {
                    "const": 1
                },
                "kind": {
                    "type": "string",
                    "minLength": 1
                },
                "payload": {
                    "$ref": "#/$defs/semanticValue"
                },
                "phase": {
                    "const": "intent"
                },
                "reversibility": {
                    "enum": [
                        "reversible",
                        "compensable",
                        "irreversible"
                    ]
                }
            },
            "additionalProperties": false
        },
        "effectOutcome": {
            "type": "object",
            "required": [
                "effect_id",
                "intent_ref",
                "kind",
                "outcome_version",
                "phase",
                "result"
            ],
            "properties": {
                "effect_id": {
                    "type": "string",
                    "minLength": 1
                },
                "intent_ref": {
                    "$ref": "#/$defs/intentRef"
                },
                "kind": {
                    "type": "string",
                    "minLength": 1
                },
                "outcome_version": {
                    "const": 1
                },
                "phase": {
                    "const": "outcome"
                },
                "result": {
                    "$ref": "#/$defs/semanticValue"
                }
            },
            "additionalProperties": false
        },
        "failure": {
            "type": "object",
            "required": [
                "message",
                "name"
            ],
            "properties": {
                "message": {
                    "type": "string",
                    "x-shepherd-max-utf8-bytes": 4096
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "intentRef": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "recordId": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "semanticValue": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                },
                {
                    "type": "number"
                },
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/semanticValue"
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/semanticValue"
                    }
                }
            ]
        },
        "sessionId": {
            "type": "string",
            "pattern": "^replay-session:sha256:[0-9a-f]{64}$"
        },
        "task": {
            "type": "object",
            "required": [
                "artifact_lock",
                "input",
                "instruction",
                "output_schema"
            ],
            "properties": {
                "artifact_lock": {
                    "type": "object",
                    "required": [
                        "artifact_digest",
                        "artifact_lock_version",
                        "compatibility_version",
                        "descriptor_version",
                        "schema_digest",
                        "task_id",
                        "task_version"
                    ],
                    "properties": {
                        "artifact_digest": {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                        },
                        "artifact_lock_version": {
                            "const": 1
                        },
                        "compatibility_version": {
                            "const": "shepherd.tasks.v1"
                        },
                        "descriptor_version": {
                            "const": 1
                        },
                        "schema_digest": {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                        },
                        "task_id": {
                            "type": "string",
                            "pattern": "^task:sha256:[0-9a-f]{64}$"
                        },
                        "task_version": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "additionalProperties": false
                },
                "input": {
                    "$ref": "#/$defs/semanticValue"
                },
                "instruction": {
                    "type": "string",
                    "minLength": 1
                },
                "output_schema": {
                    "type": "object"
                }
            },
            "additionalProperties": false
        }
    }
}
