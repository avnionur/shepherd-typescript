{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/application-evaluation-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Application Evaluation Report v1",
    "description": "Measured-only offline evaluation report: one run and one configured baseline per experiment with measured metrics, per-metric comparisons, and the published limitations. The report identity is the digest of the canonical report body without it; no wall-clock, host, node version, or duration field is admitted.",
    "type": "object",
    "required": [
        "baselines",
        "comparisons",
        "compatibility_version",
        "evaluation_id",
        "limitations",
        "metrics",
        "report_id",
        "report_version",
        "revision",
        "runs"
    ],
    "properties": {
        "baselines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
                "type": "object",
                "required": [
                    "evidence",
                    "experiment_id",
                    "kind",
                    "metrics"
                ],
                "properties": {
                    "evidence": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "minLength": 1
                        },
                        "uniqueItems": true
                    },
                    "experiment_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "kind": {
                        "enum": [
                            "no_supervision",
                            "full_replay",
                            "no_compression",
                            "single_rollout"
                        ]
                    },
                    "metrics": {
                        "$ref": "#/$defs/metrics"
                    }
                },
                "additionalProperties": false
            }
        },
        "comparisons": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
                "type": "object",
                "required": [
                    "baseline_kind",
                    "experiment_id",
                    "values"
                ],
                "properties": {
                    "baseline_kind": {
                        "enum": [
                            "no_supervision",
                            "full_replay",
                            "no_compression",
                            "single_rollout"
                        ]
                    },
                    "experiment_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "values": {
                        "type": "array",
                        "minItems": 6,
                        "maxItems": 6,
                        "items": {
                            "type": "object",
                            "required": [
                                "application",
                                "baseline",
                                "delta",
                                "metric"
                            ],
                            "properties": {
                                "application": {
                                    "oneOf": [
                                        {
                                            "type": "null"
                                        },
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "boolean"
                                        }
                                    ]
                                },
                                "baseline": {
                                    "oneOf": [
                                        {
                                            "type": "null"
                                        },
                                        {
                                            "type": "number"
                                        },
                                        {
                                            "type": "boolean"
                                        }
                                    ]
                                },
                                "delta": {
                                    "oneOf": [
                                        {
                                            "type": "null"
                                        },
                                        {
                                            "type": "number"
                                        }
                                    ]
                                },
                                "metric": {
                                    "enum": [
                                        "cost_usd",
                                        "provider_calls",
                                        "input_tokens",
                                        "output_tokens",
                                        "steps",
                                        "success"
                                    ]
                                }
                            },
                            "additionalProperties": false
                        }
                    }
                },
                "additionalProperties": false
            }
        },
        "compatibility_version": {
            "const": "shepherd.applications.v1"
        },
        "evaluation_id": {
            "type": "string",
            "minLength": 1
        },
        "limitations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "text"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                    }
                },
                "additionalProperties": false
            }
        },
        "metrics": {
            "const": [
                "cost_usd",
                "provider_calls",
                "input_tokens",
                "output_tokens",
                "steps",
                "success"
            ]
        },
        "report_id": {
            "type": "string",
            "pattern": "^evaluation-report:sha256:[0-9a-f]{64}$"
        },
        "report_version": {
            "const": 1
        },
        "revision": {
            "type": "string",
            "minLength": 1
        },
        "runs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
                "type": "object",
                "required": [
                    "application_id",
                    "costs",
                    "dataset",
                    "experiment_id",
                    "kind",
                    "manifest_id",
                    "metrics",
                    "protocol_id",
                    "protocol_version",
                    "seeds"
                ],
                "properties": {
                    "application_id": {
                        "type": "string",
                        "pattern": "^application:sha256:[0-9a-f]{64}$"
                    },
                    "costs": {
                        "type": "object",
                        "required": [
                            "cache_creation_input_tokens",
                            "cache_read_input_tokens",
                            "cost_usd",
                            "input_tokens",
                            "output_tokens",
                            "provider_calls"
                        ],
                        "properties": {
                            "cache_creation_input_tokens": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "cache_read_input_tokens": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "cost_usd": {
                                "oneOf": [
                                    {
                                        "type": "null"
                                    },
                                    {
                                        "type": "number",
                                        "minimum": 0
                                    }
                                ]
                            },
                            "input_tokens": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "output_tokens": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "provider_calls": {
                                "type": "integer",
                                "minimum": 0
                            }
                        },
                        "additionalProperties": false
                    },
                    "dataset": {
                        "type": "object",
                        "required": [
                            "id",
                            "items",
                            "revision"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "minLength": 1
                            },
                            "items": {
                                "type": "array",
                                "maxItems": 64,
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "uniqueItems": true
                            },
                            "revision": {
                                "type": "string",
                                "minLength": 1
                            }
                        },
                        "additionalProperties": false
                    },
                    "experiment_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "kind": {
                        "enum": [
                            "coding_supervisor",
                            "counterfactual_optimization",
                            "trajectory_compression",
                            "tree_rl"
                        ]
                    },
                    "manifest_id": {
                        "type": "string",
                        "pattern": "^application-manifest:sha256:[0-9a-f]{64}$"
                    },
                    "metrics": {
                        "$ref": "#/$defs/metrics"
                    },
                    "protocol_id": {
                        "type": "string",
                        "pattern": "^application-protocol:sha256:[0-9a-f]{64}$"
                    },
                    "protocol_version": {
                        "type": "string",
                        "minLength": 1
                    },
                    "seeds": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 16,
                        "items": {
                            "type": "integer"
                        },
                        "uniqueItems": true
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "metrics": {
            "type": "object",
            "required": [
                "cost_usd",
                "input_tokens",
                "output_tokens",
                "provider_calls",
                "steps",
                "success"
            ],
            "properties": {
                "cost_usd": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "type": "number",
                            "minimum": 0
                        }
                    ]
                },
                "provider_calls": {
                    "type": "integer",
                    "minimum": 0
                },
                "input_tokens": {
                    "type": "integer",
                    "minimum": 0
                },
                "output_tokens": {
                    "type": "integer",
                    "minimum": 0
                },
                "steps": {
                    "type": "integer",
                    "minimum": 0
                },
                "success": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        }
    }
}
