{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/delegation-completion-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Delegation Completion v1",
    "description": "Completion of one child run: cites the child's terminal record and published cut.",
    "type": "object",
    "required": [
        "compatibility_version",
        "delegation_version",
        "child_cut_id",
        "child_run_id",
        "child_terminal_record_id",
        "execution_kind",
        "handle_id",
        "status",
        "supervisor_id"
    ],
    "properties": {
        "compatibility_version": {
            "const": "shepherd.delegation.v1"
        },
        "delegation_version": {
            "const": 1
        },
        "child_cut_id": {
            "type": "string",
            "minLength": 1
        },
        "child_run_id": {
            "type": "string",
            "pattern": "^delegation-run:sha256:[0-9a-f]{64}$"
        },
        "child_terminal_record_id": {
            "$ref": "#/$defs/recordId"
        },
        "execution_kind": {
            "enum": [
                "provider",
                "program"
            ]
        },
        "handle_id": {
            "$ref": "#/$defs/handleId"
        },
        "status": {
            "enum": [
                "finished",
                "failed",
                "exhausted",
                "cancelled"
            ]
        },
        "supervisor_id": {
            "$ref": "#/$defs/supervisorId"
        }
    },
    "additionalProperties": false,
    "$defs": {
        "budget": {
            "type": "object",
            "properties": {
                "maxCostUsd": {
                    "type": "number",
                    "minimum": 0
                },
                "maxDurationMilliseconds": {
                    "type": "integer",
                    "minimum": 1
                },
                "maxEffects": {
                    "type": "integer",
                    "minimum": 0
                },
                "maxInputTokens": {
                    "type": "integer",
                    "minimum": 0
                },
                "maxOutputTokens": {
                    "type": "integer",
                    "minimum": 0
                },
                "maxTurns": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "grants": {
            "type": "array",
            "maxItems": 64,
            "items": {
                "type": "object",
                "required": [
                    "atoms",
                    "resource_id",
                    "resource_kind"
                ],
                "properties": {
                    "atoms": {
                        "type": "array",
                        "items": {
                            "enum": [
                                "read",
                                "write"
                            ]
                        },
                        "uniqueItems": true
                    },
                    "resource_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "resource_kind": {
                        "enum": [
                            "repository_binding",
                            "workspace_binding"
                        ]
                    }
                },
                "additionalProperties": false
            }
        },
        "handleId": {
            "type": "string",
            "pattern": "^delegation:sha256:[0-9a-f]{64}$"
        },
        "recordId": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "semanticValue": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                },
                {
                    "type": "number"
                },
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/semanticValue"
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/semanticValue"
                    }
                }
            ]
        },
        "supervisorId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
        },
        "taskArtifactLock": {
            "type": "object",
            "required": [
                "artifact_digest",
                "artifact_lock_version",
                "compatibility_version",
                "descriptor_version",
                "schema_digest",
                "task_id",
                "task_version"
            ],
            "properties": {
                "artifact_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "artifact_lock_version": {
                    "const": 1
                },
                "compatibility_version": {
                    "const": "shepherd.tasks.v1"
                },
                "descriptor_version": {
                    "const": 1
                },
                "schema_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "task_id": {
                    "type": "string",
                    "pattern": "^task:sha256:[0-9a-f]{64}$"
                },
                "task_version": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "taskDescriptor": {
            "type": "object",
            "required": [
                "compatibility_version",
                "descriptor_version",
                "input_schema",
                "instruction",
                "name",
                "output_schema",
                "task_version"
            ],
            "properties": {
                "compatibility_version": {
                    "const": "shepherd.tasks.v1"
                },
                "descriptor_version": {
                    "const": 1
                },
                "input_schema": {
                    "$ref": "#/$defs/taskSchema"
                },
                "instruction": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "output_schema": {
                    "$ref": "#/$defs/taskSchema"
                },
                "task_version": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "taskSchema": {
            "oneOf": [
                {
                    "type": "object",
                    "required": [
                        "type"
                    ],
                    "properties": {
                        "type": {
                            "const": "string"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "type"
                    ],
                    "properties": {
                        "type": {
                            "const": "null"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "additionalProperties",
                        "properties",
                        "required",
                        "type"
                    ],
                    "properties": {
                        "additionalProperties": {
                            "const": false
                        },
                        "properties": {
                            "type": "object",
                            "additionalProperties": {
                                "$ref": "#/$defs/taskSchema"
                            }
                        },
                        "required": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "minLength": 1
                            },
                            "uniqueItems": true
                        },
                        "type": {
                            "const": "object"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "$ref"
                    ],
                    "properties": {
                        "$ref": {
                            "const": "https://avnionur.github.io/shepherd-typescript/schemas/task-value-v1.schema.json"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "type"
                    ],
                    "properties": {
                        "type": {
                            "enum": [
                                "boolean",
                                "integer",
                                "number"
                            ]
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "items",
                        "type"
                    ],
                    "properties": {
                        "items": {
                            "$ref": "#/$defs/taskSchema"
                        },
                        "type": {
                            "const": "array"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "enum"
                    ],
                    "properties": {
                        "enum": {
                            "type": "array",
                            "items": {
                                "anyOf": [
                                    {
                                        "type": "boolean"
                                    },
                                    {
                                        "type": "null"
                                    },
                                    {
                                        "type": "number"
                                    },
                                    {
                                        "type": "string"
                                    }
                                ]
                            },
                            "minItems": 1,
                            "uniqueItems": true
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "const"
                    ],
                    "properties": {
                        "const": {
                            "anyOf": [
                                {
                                    "type": "boolean"
                                },
                                {
                                    "type": "null"
                                },
                                {
                                    "type": "number"
                                },
                                {
                                    "type": "string"
                                }
                            ]
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "oneOf"
                    ],
                    "properties": {
                        "oneOf": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/taskSchema"
                            },
                            "minItems": 2,
                            "uniqueItems": true
                        }
                    },
                    "additionalProperties": false
                }
            ]
        },
        "taskValue": {
            "type": "object",
            "required": [
                "artifact",
                "artifact_lock"
            ],
            "properties": {
                "artifact": {
                    "$ref": "#/$defs/taskDescriptor"
                },
                "artifact_lock": {
                    "$ref": "#/$defs/taskArtifactLock"
                }
            },
            "additionalProperties": false
        }
    }
}
