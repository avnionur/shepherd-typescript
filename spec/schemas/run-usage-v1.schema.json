{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/run-usage-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Run Usage v1",
    "description": "Aggregate resource-use totals for an entire run.",
    "type": "object",
    "required": [
        "usage_version",
        "run_id",
        "input_tokens",
        "output_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "cost_usd"
    ],
    "properties": {
        "usage_version": {
            "const": 1
        },
        "run_id": {
            "type": "string",
            "minLength": 1
        },
        "input_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "output_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "cache_creation_input_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "cache_read_input_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
        },
        "cost_usd": {
            "anyOf": [
                {
                    "type": "number",
                    "minimum": 0
                },
                {
                    "type": "null"
                }
            ]
        }
    },
    "additionalProperties": false
}
