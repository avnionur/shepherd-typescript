{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/trace-archive-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Native Trace Archive v1",
    "description": "Complete identity-preserving retained trace-store interchange.",
    "type": "object",
    "required": [
        "append_intents",
        "blobs",
        "canonical_version",
        "cuts",
        "format",
        "format_version",
        "kernel_abi_version",
        "record_views",
        "records"
    ],
    "properties": {
        "append_intents": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/appendIntent"
            }
        },
        "blobs": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/blob"
            }
        },
        "canonical_version": {
            "const": "shepherd.kernel.canonical.v2"
        },
        "cuts": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/cut"
            }
        },
        "format": {
            "const": "shepherd.trace.archive"
        },
        "format_version": {
            "const": 1
        },
        "kernel_abi_version": {
            "const": "shepherd.kernel.abi.v0"
        },
        "record_views": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/recordView"
            }
        },
        "records": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/record"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "appendIntent": {
            "type": "object",
            "required": [
                "append_intent_id",
                "batch_digest",
                "receipt_json"
            ],
            "properties": {
                "append_intent_id": {
                    "type": "string",
                    "minLength": 1
                },
                "batch_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "receipt_json": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "blob": {
            "type": "object",
            "required": [
                "blob_id",
                "byte_length",
                "content_base64"
            ],
            "properties": {
                "blob_id": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "byte_length": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                },
                "content_base64": {
                    "type": "string",
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                }
            },
            "additionalProperties": false
        },
        "cut": {
            "type": "object",
            "required": [
                "append_intent_id",
                "created_by_record_id",
                "cut_id",
                "publisher_owner_id",
                "target_owner_id",
                "through_owner_ordinal",
                "through_record_id"
            ],
            "properties": {
                "append_intent_id": {
                    "type": "string",
                    "minLength": 1
                },
                "created_by_record_id": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "cut_id": {
                    "type": "string",
                    "minLength": 1
                },
                "publisher_owner_id": {
                    "type": "string",
                    "minLength": 1
                },
                "target_owner_id": {
                    "type": "string",
                    "minLength": 1
                },
                "through_owner_ordinal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740990
                },
                "through_record_id": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                }
            },
            "additionalProperties": false
        },
        "record": {
            "type": "object",
            "required": [
                "body",
                "envelope"
            ],
            "properties": {
                "body": {
                    "$ref": "https://avnionur.github.io/shepherd-typescript/schemas/record-body-v0.schema.json"
                },
                "envelope": {
                    "$ref": "https://avnionur.github.io/shepherd-typescript/schemas/record-envelope-v0.schema.json"
                }
            },
            "additionalProperties": false
        },
        "recordView": {
            "type": "object",
            "required": [
                "append_intent_id",
                "append_position",
                "owner_id",
                "owner_ordinal",
                "record_id"
            ],
            "properties": {
                "append_intent_id": {
                    "type": "string",
                    "minLength": 1
                },
                "append_position": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                },
                "owner_id": {
                    "type": "string",
                    "minLength": 1
                },
                "owner_ordinal": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740990
                },
                "record_id": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                }
            },
            "additionalProperties": false
        }
    }
}
