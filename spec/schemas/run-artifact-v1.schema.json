{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://avnionur.github.io/shepherd-typescript/schemas/run-artifact-v1.schema.json",
    "$comment": "Generated from protocol.config.json. Do not edit directly.",
    "title": "Shepherd Run Artifact v1",
    "description": "One ordered side-channel output emitted by a run.",
    "type": "object",
    "required": [
        "artifact_version",
        "run_id",
        "artifact_ordinal",
        "kind",
        "name",
        "content",
        "metadata"
    ],
    "properties": {
        "artifact_version": {
            "const": 1
        },
        "run_id": {
            "type": "string",
            "minLength": 1
        },
        "artifact_ordinal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740990
        },
        "kind": {
            "type": "string",
            "minLength": 1
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "content": {
            "oneOf": [
                {
                    "type": "object",
                    "required": [
                        "type",
                        "text"
                    ],
                    "properties": {
                        "type": {
                            "const": "text"
                        },
                        "text": {
                            "type": "string"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": [
                        "type",
                        "blob_id",
                        "byte_length"
                    ],
                    "properties": {
                        "type": {
                            "const": "blob"
                        },
                        "blob_id": {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                        },
                        "byte_length": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                        }
                    },
                    "additionalProperties": false
                }
            ]
        },
        "metadata": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/semanticValue"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "semanticValue": {
            "anyOf": [
                {
                    "type": "boolean"
                },
                {
                    "type": "null"
                },
                {
                    "type": "number"
                },
                {
                    "type": "string"
                },
                {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/semanticValue"
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/semanticValue"
                    }
                }
            ]
        }
    }
}
