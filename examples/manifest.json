{
    "documentation": ["docs/python-to-typescript.md"],
    "examples": [
        {
            "source": "examples/custom-effects.ts",
            "configuration": "examples/custom-effects.json",
            "expectedResult": {
                "successHandler": "format:local",
                "success": { "ok": true, "value": "Reviewed: sample" },
                "failureHandler": "format:local",
                "failure": { "ok": false, "error": { "code": "CONTENT_DECLINED" } },
                "manualOutcomeCorrelated": true,
                "changedIntentRejected": true,
                "unhandledCode": "EFFECT_HANDLER_NOT_FOUND"
            },
            "expectedFiles": {}
        },
        {
            "source": "examples/multiple-bindings.ts",
            "configuration": "examples/multiple-bindings.json",
            "expectedResult": {
                "bindings": ["application", "documentation"],
                "beforeSelection": ["original application\n", "original documentation\n"],
                "afterEachSelection": [
                    ["updated application\n", "original documentation\n"],
                    ["updated application\n", "updated documentation\n"]
                ],
                "settlementStates": [["selected"], ["selected"]]
            },
            "expectedFiles": {
                "application/content.txt": "updated application\n",
                "documentation/content.txt": "updated documentation\n"
            }
        },
        {
            "source": "examples/retained-coding.ts",
            "configuration": "examples/retained-coding.json",
            "expectedResult": {
                "changedPaths": ["greet.ts"],
                "beforeSelection": "export function greet(): string { return \"Hello\"; }\n",
                "retainedSource": "export function greet(name: string): string { return \"Hello, \" + name + \"!\"; }\n",
                "afterSelection": "export function greet(name: string): string { return \"Hello, \" + name + \"!\"; }\n",
                "runStatus": "committed",
                "settlementStates": ["selected"]
            },
            "reviews": [
                {
                    "source": "examples/read-only-review.ts",
                    "configuration": "examples/read-only-review.json",
                    "expectedResult": {
                        "runId": "run:retained-coding",
                        "changedPaths": ["greet.ts"],
                        "total": 1,
                        "nextOffset": null,
                        "preview": "export function greet(name: string): string { return \"Hello, \" + name + \"!\"; }\n",
                        "truncated": false,
                        "settlementStates": ["selected"],
                        "traceUnchanged": true
                    }
                }
            ],
            "expectedFiles": {
                "greet.ts": "export function greet(name: string): string { return \"Hello, \" + name + \"!\"; }\n"
            }
        }
    ]
}
