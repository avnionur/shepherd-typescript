{
    "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
    "files": {
        "includes": [
            "**",
            "!!.claude",
            "!!dist",
            "!!.git",
            "!!docs/generated/application-evaluation.json",
            "!!docs/generated/sbom.cdx.json",
            "!!node_modules",
            "!!release",
            "!!spec/compatibility",
            "!!spec/schemas",
            "!!template"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
